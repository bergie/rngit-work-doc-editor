{
  "name": "rngit-work-doc-editor",
  "version": "0.1.0",
  "description": "Terminal UI for reading and managing rngit work documents over the Reticulum mesh",
  "license": "EUPL-1.2",
  "author": "Henri Bergius <henri.bergius@iki.fi>",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "rngit-work-tui": "bin/rngit-work-tui.js"
  },
  "keywords": [
    "reticulum",
    "rns",
    "rngit",
    "tui",
    "work-documents"
  ],
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "lint": "npx @biomejs/biome check --use-editorconfig=true src/ bin/ test/ scripts/",
    "typecheck": "tsc --noEmit",
    "format": "npx @biomejs/biome check --use-editorconfig=true --write src/ bin/ test/ scripts/",
    "start": "node bin/rngit-work-tui.js",
    "test": "tsc --noEmit && node --test --test-force-exit test/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@digitaldefiance/bzip2-wasm": "^1.1.1",
    "@reticulum/core": "^0.9.7",
    "@reticulum/node": "^0.9.7",
    "ink": "^8.0.0",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "react": "^19.1.0",
    "wrap-ansi": "^9.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
