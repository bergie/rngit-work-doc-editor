{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "es2023",
		"lib": ["es2023"],
		"types": ["node"],
		"strict": true,
		"noImplicitOverride": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*.js", "bin/**/*.js", "test/**/*.js", "scripts/**/*.js", "src/**/*.d.ts"]
}
